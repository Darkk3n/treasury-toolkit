<!-- Dark palette. Colors match v1's dark mode (MainForm.UpdateApplicationTheme and the views' ApplyTheme). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3F3F46" />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1E90FF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#1C97EA" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#8A8A8A" />

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#A9A9A9" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#2A2A2D" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="NavSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarToggleForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="GridLinesBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="LinkBrush" Color="#3FA9F5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2C94C" />
</ResourceDictionary>
