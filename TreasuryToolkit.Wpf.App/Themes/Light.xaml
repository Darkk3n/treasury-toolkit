<!-- Light palette. Colors match v1's light mode (MainForm.UpdateApplicationTheme and the views' ApplyTheme). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#333333" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#ABADB3" />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1E90FF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#A0A0A0" />

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E6EBF0" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#404040" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#D5DCE4" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="NavSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarToggleForegroundBrush" Color="#000000" />

    <SolidColorBrush x:Key="GridLinesBrush" Color="#D3D3D3" />
    <SolidColorBrush x:Key="LinkBrush" Color="#0066CC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C27C0E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
</ResourceDictionary>
