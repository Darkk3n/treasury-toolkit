<!-- Themed replacement for MessageBox, used for every dialog the app shows (the native Win32 message box can't
     follow the app's theme). Shown through IDialogService; Enter picks the primary button and Esc the secondary
     one, or closes the window when there's only one button. -->
<Window x:Class="TreasuryToolkit.Wpf.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="15">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Glyph and color are set per message kind in code-behind -->
        <TextBlock x:Name="IconText"
                   Margin="0,2,16,0"
                   VerticalAlignment="Top"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="32" />

        <!-- The title is shown here as a heading: the native title bar's font is fixed by Windows and too small
             next to the message, so the title bar itself is left empty -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" MinWidth="100" IsDefault="True" Click="Primary_Click" />
            <Button x:Name="SecondaryButton" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
