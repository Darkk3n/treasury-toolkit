<!-- Port of v1's UcAbout. Text is kept verbatim; font sizes are v1's point sizes converted to WPF units (pt × 96/72). -->
<UserControl x:Class="TreasuryToolkit.Wpf.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TreasuryToolkit.Wpf.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="PillarHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="TreasuryToolkit" FontSize="24" />
            <TextBlock Margin="0,4,0,12" Text="{Binding VersionText}" FontSize="13" FontStyle="Italic" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13.3"
                       Text="Una herramienta de automatización de alto rendimiento, con prioridad local, diseñada para optimizar las operaciones financieras, eliminar la fricción del procesamiento manual de documentos y garantizar el estricto cumplimiento de los datos en todos los flujos de trabajo corporativos." />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Impacto y Pilares de Ingeniera" />

            <TextBlock Style="{StaticResource PillarHeader}" Text="Eficiencia Operativa:" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Recupera cientos de horas operativas anuales transformando tareas complejas de división, extracción y formato de archivos PDF en flujos de trabajo automatizados que se ejecutan con un solo clic." />

            <TextBlock Style="{StaticResource PillarHeader}" Text="Seguridad y Privacidad:" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Arquitectura de ejecución local que garantiza el cumplimiento estricto de manejo de datos." />

            <TextBlock Style="{StaticResource PillarHeader}" Text="Robustez Arquitectónica:" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Desarrollado bajo estándares modernos de Microsoft .NET, asegurando un sistema estable y escalable." />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Liderazgo en Ingenieria" />
            <TextBlock Style="{StaticResource BodyText}">
                <Bold>TreasuryToolkit</Bold>
                <Run Text=" fue diseñado, arquitectado e implementado desde cero por " />
                <Bold>Gerardo Aguilar (Desarrollador Senior Full-Stack)</Bold>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}"
                       Text="Especializado en ecosistemas empresariales modernos, arquitectura de software full-stack y pipelines de automatización operativa. Esta herramienta representa un compromiso con la excelencia técnica: construir soluciones robustas, confiables y de alto rendimiento que transforman problemas de negocio complejos en interfaces elegantes y funcionales." />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}">
                <Run Text="¿Requiere soluciones de automatización a la medida o consultoría técnica? Conozca más de mi trabajo en " />
                <Hyperlink Style="{StaticResource LinkStyle}" Command="{Binding OpenGitHubCommand}">GitHub</Hyperlink>
                <Run Text=" o contacteme mediante " />
                <Hyperlink Style="{StaticResource LinkStyle}" Command="{Binding SendEmailCommand}">correo electrónico</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
