<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <!-- Point InPath to where dotnet publish wrote the files -->
  <Var Name="InPath" Value="../publish" />
  <Var Name="OutPath" Value="../publish/obfuscated" />

  <Var Name="ReuseNames" Value="true" />
  <Var Name="HidePrivateApi" Value="true" />
  <Var Name="KeepPublicApi" Value="false" />
  <Var Name="Optimize" Value="true" />
  <Var Name="SuppressIldasm" Value="true" />

  <!-- Tell Obfuscar to search the publish directory for dependencies -->
  <Var Name="AssemblySearchPath" Value="../publish" />

  <Module Name="$(InPath)\TreasuryToolkit.App.dll" />
</Obfuscator>
