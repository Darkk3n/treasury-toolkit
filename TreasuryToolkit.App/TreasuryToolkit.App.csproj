<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
		<ApplicationIcon>Icon3.ico</ApplicationIcon>
		<AssemblyName>TreasuryToolkit</AssemblyName>
		<AssemblyTitle>TreasuryToolkit</AssemblyTitle>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Data\companies.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\companies.json">
		</EmbeddedResource>
		<Content Include="Icon3.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="itext" Version="9.6.0" />
		<PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
		<PackageReference Include="itext.font-asian" Version="9.6.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Obfuscar" Version="2.2.50">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TreasuryToolkit.Core\TreasuryToolkit.Core.csproj" />
		<ProjectReference Include="..\TreasuryToolkit.Infra\TreasuryToolkit.Infra.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="ObfuscateAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Message Text="=== RUNNING OBFUSCAR IN MSBUILD CONTEXT ===" Importance="high" />
		<!-- Obfuscar cannot use the same path for InPath and OutPath (it still holds the input
		     file open while writing output), so it writes to a scratch subfolder here and we
		     copy the obfuscated assembly back over the original build output afterward. -->
		<Exec Command="$(Obfuscar) &quot;$(MSBuildProjectDirectory)\obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" />
		<ItemGroup>
			<ObfuscatedAssemblies Include="$(TargetDir)obfuscated\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(ObfuscatedAssemblies)" DestinationFolder="$(TargetDir)" />
		<RemoveDir Directories="$(TargetDir)obfuscated" />
	</Target>

	<ItemGroup>
		<None Update="obfuscar.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>
</Project>
